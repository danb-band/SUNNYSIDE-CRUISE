generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String              @id @db.Uuid
  name      String
  realName  String
  comment   Comment[]
  song_like SongLike[]
  rsvp      CalendarEventRsvp[]
  player    Player[]

  @@map("profiles")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Comment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  songId    String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  userId    String    @db.Uuid
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  song      Song      @relation(fields: [songId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "comments_song_id_fkey")

  @@map("comment")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Player {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  songId     String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  instrument String
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  profile    Profile   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  song       Song      @relation(fields: [songId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "players_song_id_fkey")

  @@map("player")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Season {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  sortOrder  BigInt
  isArchived Boolean
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)
  song       Song[]

  @@map("season")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Song {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId    String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  artist      String
  description String
  youtubeUrl  String
  sortOrder   BigInt
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @db.Timestamptz(6)
  deletedAt   DateTime?  @db.Timestamptz(6)
  userId      String     @db.Uuid
  likeCount   Int        @default(0)
  comment     Comment[]
  player      Player[]
  season      Season     @relation(fields: [seasonId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "songs_season_id_fkey")
  songLike    SongLike[]

  @@map("song")
}

model CalendarEvent {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  location  String
  startDate DateTime            @db.Timestamptz(6)
  endDate   DateTime            @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @default(now()) @db.Timestamptz(6)
  rsvp      CalendarEventRsvp[]

  @@map("calendar_event")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CalendarEventRsvp {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String        @db.Uuid
  userId    String        @db.Uuid
  status    RsvpStatus
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @db.Timestamptz(6)
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile   Profile       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([eventId, userId])
  @@map("calendar_event_rsvp")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SongLike {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  songId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  profiles  Profile  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([songId, userId])
  @@map("song_like")
}

enum RsvpStatus {
  ATTENDING
  NOT_ATTENDING
}
